        </aapt:attr>
    </path>

    <!-- 6. 玻璃高光弧 -->
    <path
        android:fillColor="#88FFFFFF"
        android:pathData="M 42,42 C 45,36 53,35 60,37 C 54,38 48,42 45,47 C 43,50 41,47 42,42 Z"/>

