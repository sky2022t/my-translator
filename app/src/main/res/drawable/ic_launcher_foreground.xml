    <path android:pathData="M 54,54 m -18,0 a 18,18 0 1,1 36,0 a 18,18 0 1,1 -36,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="48"
                android:gradientRadius="22"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFF"/>
                <item android:offset="0.22" android:color="#FFF59D"/>
                <item android:offset="0.52" android:color="#FFB300"/>
                <item android:offset="0.82" android:color="#FF6D00"/>
                <item android:offset="1.0" android:color="#D84315"/>
