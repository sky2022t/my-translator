    <!-- 4. 星轨 B（极光蓝目标语言轨道） -->
    <group
        android:rotation="34"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:strokeColor="#B338BDF8"
            android:strokeWidth="1.6"
            android:pathData="M 25,54 a 29,11.5 0 1,0 58,0 a 29,11.5 0 1,0 -58,0"/>
