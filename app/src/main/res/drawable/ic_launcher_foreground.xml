    </group>

    <!-- 3. 星轨 A（金黄源语言轨道） -->
    <group
        android:rotation="-26"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:strokeColor="#CCFFD54F"
            android:strokeWidth="1.8"
            android:pathData="M 22,54 a 32,13 0 1,0 64,0 a 32,13 0 1,0 -64,0"/>
